   function googleTranslateElementInit() {
     new google.translate.TranslateElement({pageLanguage: 'en', includedLanguages: 'en,es,fr,pt,pt-PT,ar,km,ht,zh-CN,lo,hmn,sw,ru,uk', layout: google.translate.TranslateElement.InlineLayout.SIMPLE, autoDisplay: false, gaTrack: true, gaId: 'UA-1141659-7'}, 'google_translate_element');

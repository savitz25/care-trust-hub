   <div id="color_scheme"></div>
   <script>
   const htmlTag = document.querySelector('html');
   // Get the element that will be clicked
   const toggleButton = document.getElementById('color_scheme');

   // Add an event listener to the element
   toggleButton.addEventListener('click', function() {
     // Check the current text content of the element
     if (toggleButton.textContent === 'Switch to Dark') {
       // Update the text content to 'Switch to light'
       htmlTag.classList.remove('light');
       htmlTag.classList.add('dark');
       toggleButton.textContent = 'Switch to Light';
     } else {
       // Update the text content to 'Switch to dark'
       toggleButton.textContent = 'Switch to Dark';
       htmlTag.classList.remove('dark');
       htmlTag.classList.add('light');
     }
   });
   if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
     // User prefers dark mode
      if (!htmlTag.classList.contains('dark')) {
         // 'dark' class is added in the class list
         htmlTag.classList.add('dark');
      }
      toggleButton.textContent = 'Switch to Light';
   } else {
     // User prefers light mode
      if (!htmlTag.classList.contains('light')) {
         // 'light' class is added in the class list
         htmlTag.classList.add('light');
      }
      toggleButton.textContent = 'Switch to Dark';
   }
   </script>
<script>
// written by A.HerrerA: May 21, 2020
// Updated on Jan 28, 2025
$(function() {
	$("a[target!='_blank']").each(function(index) {
		var href = $(this).attr("href");
		if (href !== undefined) {
			var pdf = /\.pdf$/i;
			var result = href.match(pdf);
			if (result) {
				return $(this).attr("target", "_blank");
			}
		}
		var target = $(this).attr("target");
      if((this.href.indexOf(location.hostname) == -1) && (this.href.indexOf('javascript') == -1) && (this.href.indexOf('mailto') == -1) && (this.target.indexOf("popup") == -1)) {

         // attach a do-nothing event handler to ensure we can 'trigger' a click on this link
         $(this).click(function() { return true; }); 

         $(this).attr({
            target: "_blank",
            title: "Opens in a New Window"
         });

         $(this).click(); // trigger it
      }

	});
});
</script>

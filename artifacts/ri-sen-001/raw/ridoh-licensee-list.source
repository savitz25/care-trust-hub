<style>
#profNote {
	color: darkred;
	font-weight: bold;
	font-size: 0.9em;
	margin-top: -20px;
	padding-left: 8px;
	display: none;
}
.searchTable {
	display: none;
	height: 1000px;
	overflow-x: scroll;
	border-top: 1px solid var(--fc__table__border__v);
}
.fixed_header {
	width: 400px;
	table-layout: fixed;
	border-collapse: collapse;
}
.fixed_header tbody {
	display: block;
	width: 100%;
	overflow: auto;
	height: 100px;
}
.fixed_header thead tr {
	display: block;
}
.fixed_header thead {
	background: black;
	color: #fff;
}
.fixed_header th, .fixed_header td {
	padding: 5px;
	text-align: left;
	width: 200px;
}
.spinner {
	display: none;
	position: absolute;
	left: 40%;
	top: 30%;
	height: 200px;
	width: 200px;
	margin: 0px auto;
	-webkit-animation: rotation .6s infinite linear;
	-moz-animation: rotation .6s infinite linear;
	-o-animation: rotation .6s infinite linear;
	animation: rotation .6s infinite linear;
	border-left: 30px solid rgba(0,174,239,.15);
	border-right: 30px solid rgba(0,174,239,.15);
	border-bottom: 30px solid rgba(0,174,239,.15);
	border-top: 30px solid rgba(0,174,239,.8);
	border-radius: 100%;
}
@-webkit-keyframes rotation {
from {
-webkit-transform: rotate(0deg);
}
to {
-webkit-transform: rotate(359deg);
}
}
@-moz-keyframes rotation {
from {
-moz-transform: rotate(0deg);
}
to {
-moz-transform: rotate(359deg);
}
}
@-o-keyframes rotation {
from {
-o-transform: rotate(0deg);
}
to {
-o-transform: rotate(359deg);
}
}
@keyframes rotation {
from {
transform: rotate(0deg);
}
to {
transform: rotate(359deg);
}
}
#grid {
	border: 1px solid var(--fc__table__border__v);
}
#grid thead th {
	background-color: var(--fc__default__bg)!important;
	/*position: sticky;*/
	top: 0;
	vertical-align: middle;
}
.cssbuttons {
margin-top: calc(var(--body-text-spacer) * 1.5);
margin-bottom: calc(var(--body-text-spacer) * 0.5);
}
#info {
	border-bottom: 1px solid var(--fc__table__border__v);
}
@media (min-width: 40em) {
   p { max-width: 100%!important}
}
</style>
<script type="text/javascript">
function refreshLicense(thisValue)
{
   if (thisValue == 'Emergency Medical Services') {
      $('#profNote').html('Note: EMT Address information is not included in the extract.');
      $('#profNote').show();
   } else {
      $('#profNote').html('');
      $('#profNote').hide();
   }
   $('#prof').val(thisValue);
   $.ajax({
      type: 'post',
      url: 'refreshLicense.php',
      data: {
         profession : thisValue
      },
      success: function (response) {
          // get the info from loadTbl.php and displays it on below div
         $( '#licenseList' ).html(response);
      },
      error: function(request, status, error) {
         var val = request.responseText;
         console.log("Error: "+val+"\nError:"+error);
         //alert("Error: "+val+"\nError:"+error);
      }
   });
}

// performs query
function doQuery() {
   if (!$('#jx-profession').val()) { alert('Please select a Profession. Thank you.'); return false;}
   document.body.style.cursor = "progress";
   $('.spinner').show();
   $('#output').text('');
   $.ajax({
      type: 'post',
      url: 'getList.php',
      data: {
         jxProfession : $('#jx-profession').val(),
         jxLicense : $('#jx-license').val()
      },
      success: function (response) {
         // hides loading spinner
         document.body.style.cursor = "auto";
         $('.spinner').hide();
         $('.searchTable').show();
         // get the info from getList.php and displays it on below div
         $( '#tableBody' ).html(response);
         $('#NumbRows').html("<p style='font-size: 1.2em;margin-top: 1.25em;'>Total Number of Records : "+numbRows+"</p>");
         $('#preview').show();
         $('#output').text(outputQry);
         $('#info').html(info);
         $('#licType').val($('#jx-license').val());
         document.getElementById('output').style.display="inline";
         document.getElementById('output').readOnly = true;
         document.getElementById('downloadbutton').style.display="inline";
      },
      error: function(request, status, error) {
         var val = request.responseText;
         console.log("Error: "+val+"\nError:"+error);
               }
   });
}
        
</script>

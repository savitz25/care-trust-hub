# Public canonical origin used to construct metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PostgreSQL connection. Never prefix this variable with NEXT_PUBLIC_.
CARE_DATABASE_URL=

# Prefer verify-full. Some managed poolers require encrypted `require` mode.
CARE_DATABASE_SSL=verify-full

# Real-data inspection routes require explicit local opt-in and remain disabled in production.
CARE_ENABLE_DEVELOPMENT_DATA=false

# Controlled server-side consumer integration. Keep false until explicit launch approval.
CARE_ENABLE_REAL_PROVIDER_UI=false

# Independent review gate for CMS inspections, deficiencies, penalties, and history.
# Has no effect unless CARE_ENABLE_REAL_PROVIDER_UI is also true.
CARE_ENABLE_INSPECTION_INTELLIGENCE=false

# Server-only PBJ Daily Nurse Staffing review gate. Requires real provider UI.
CARE_ENABLE_STAFFING_INTELLIGENCE=false

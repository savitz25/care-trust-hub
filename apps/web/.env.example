# Public canonical origin used to construct metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only PostgreSQL connection. Never prefix this variable with NEXT_PUBLIC_.
# Web runtime prefers the Supabase transaction pooler (port 6543).
CARE_DATABASE_URL=

# Optional explicit transaction-pooler URL for the web runtime.
CARE_DATABASE_POOLER_URL=

# auto (default) rewrites a Supabase session-pooler URL to transaction mode.
# session keeps the incoming URL. transaction requires a 6543 pooler URL.
CARE_DATABASE_POOL_MODE=auto

# Per Vercel instance. Keep 1, never above 2.
CARE_DATABASE_POOL_MAX=1

# Prefer verify-full. Some managed poolers require encrypted `require` mode.
CARE_DATABASE_SSL=verify-full

# Server-only credential for bounded Google Places enrichment requests.
GOOGLE_PLACES_API_KEY=

# Real-data inspection routes require explicit local opt-in and remain disabled in production.
CARE_ENABLE_DEVELOPMENT_DATA=false

# Controlled server-side consumer integration. Keep false until explicit launch approval.
CARE_ENABLE_REAL_PROVIDER_UI=false

# Independent review gate for CMS inspections, deficiencies, penalties, and history.
# Has no effect unless CARE_ENABLE_REAL_PROVIDER_UI is also true.
CARE_ENABLE_INSPECTION_INTELLIGENCE=false

# Server-only PBJ Daily Nurse Staffing review gate. Requires real provider UI.
CARE_ENABLE_STAFFING_INTELLIGENCE=false

# Fail-closed CA/NY/TX state-license publication. Requires real provider UI and an exact opt-in.
CARE_ENABLE_STATE_REGULATORY_INTELLIGENCE=false

# Fail-closed national facility-history timeline. Requires real provider UI and an exact opt-in.
CARE_ENABLE_FACILITY_HISTORY=false

# Fail-closed CA/NY/TX state enforcement/inspection history. Independent of license publication.
CARE_ENABLE_STATE_ENFORCEMENT_INTELLIGENCE=false

# Fail-closed ownership V2 summary and portfolio context. Requires ownership intelligence.
CARE_ENABLE_OWNERSHIP_INTELLIGENCE_V2=false

# Fail-closed Care Needs Navigator. Independent of facility-evidence flags.
CARE_ENABLE_CARE_NEEDS_NAVIGATOR=false

# Fail-closed Senior Care Cost Planner. Independent of facility-evidence flags.
CARE_ENABLE_SENIOR_CARE_COST_PLANNER=false

# Fail-closed Facility Tour & Interview Builder. Independent of other tools.
CARE_ENABLE_FACILITY_INTERVIEW_BUILDER=false

# Fail-closed Family Comparison Workspace. Independent of other tools.
CARE_ENABLE_FAMILY_COMPARISON_WORKSPACE=false

# Fail-closed assisted-living intelligence. Leave off until Task 022B public pages.
CARE_ENABLE_ASSISTED_LIVING_INTELLIGENCE=false

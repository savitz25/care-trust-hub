{
  "name": "ask-trust-hub-care",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@care/web",
    "build": "npm run build --workspace=@care/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:ath-cust-net-002a": "npm exec --workspace=@care/web vitest -- run --configLoader runner src/server/customer-integration/customer-integration.test.ts",
    "check:sen-cust-cap-001": "npm --workspace=@care/web exec -- vitest run --configLoader runner src/server/care/senior-customer-profile-validation.test.ts src/app/api/customer-profile-validation/v1/route.test.ts",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
